{
  "$comment": "AI Office v2 contracts (draft for review, Round 2). Merge into playbook-library/schemas.json $defs. Reuses existing $defs: KnowledgeRef. Nothing here is deployed.",
  "$defs": {
    "Uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "DataClass": { "enum": ["public", "internal", "confidential", "personal"] },
    "PlaybookRef": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,40}@[0-9]{1,3}$" },
    "ArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "version"],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/Uuid" },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "WebSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "title", "accessed_at"],
      "properties": {
        "url": { "type": "string", "pattern": "^https?://[^\\s]+$", "maxLength": 500 },
        "title": { "type": "string", "minLength": 3, "maxLength": 200 },
        "publisher": { "type": "string", "maxLength": 120 },
        "published_at": { "type": "string", "format": "date" },
        "accessed_at": { "type": "string", "format": "date" },
        "quote": { "type": "string", "maxLength": 300 }
      }
    },

    "BriefDiagnosis": {
      "$comment": "BriefDiagnosis.v1 — CMO step 1-6. Server checks: every KnowledgeRef exists and is approved; recommended_playbooks exist in registry.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "brief_id", "status", "real_task", "business_objective", "audience_tension", "what_we_know", "what_we_dont_know", "questions_to_owner", "constraints", "sensitive_topics", "recommended_depth", "recommended_playbooks", "data_class"],
      "properties": {
        "schema_version": { "const": "BriefDiagnosis.v1" },
        "brief_id": { "$ref": "#/$defs/Uuid" },
        "status": { "enum": ["ready", "needs_owner_input", "needs_research"] },
        "real_task": { "type": "string", "minLength": 20, "maxLength": 800 },
        "symptom_vs_cause": { "type": "string", "maxLength": 600 },
        "business_objective": {
          "type": "object",
          "additionalProperties": false,
          "required": ["statement", "kpi"],
          "properties": {
            "statement": { "type": "string", "minLength": 10, "maxLength": 400 },
            "kpi": {
              "type": "array", "minItems": 1, "maxItems": 3,
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["metric", "measured_by"],
                "properties": {
                  "metric": { "type": "string", "minLength": 3, "maxLength": 120 },
                  "target": { "type": "string", "maxLength": 120 },
                  "measured_by": { "type": "string", "minLength": 3, "maxLength": 200 },
                  "baseline": { "$ref": "#/$defs/KnowledgeRef" }
                }
              }
            }
          }
        },
        "audience_tension": { "type": "string", "minLength": 20, "maxLength": 600 },
        "segments": {
          "type": "array", "maxItems": 4,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["name", "situation", "barrier"],
            "properties": {
              "name": { "type": "string", "maxLength": 80 },
              "situation": { "type": "string", "maxLength": 300 },
              "barrier": { "type": "string", "maxLength": 300 },
              "trigger": { "type": "string", "maxLength": 300 }
            }
          }
        },
        "competitive_frame": { "type": "string", "maxLength": 800 },
        "what_we_know": {
          "type": "array", "maxItems": 20,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["statement", "source"],
            "properties": {
              "statement": { "type": "string", "minLength": 5, "maxLength": 300 },
              "source": { "$ref": "#/$defs/KnowledgeRef" }
            }
          }
        },
        "what_we_dont_know": {
          "type": "array", "maxItems": 10,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["gap", "impact", "resolve_by"],
            "properties": {
              "gap": { "type": "string", "minLength": 5, "maxLength": 300 },
              "impact": { "enum": ["high", "medium", "low"] },
              "resolve_by": { "enum": ["owner", "research", "assume"] },
              "assumption": { "type": "string", "maxLength": 300 }
            },
            "allOf": [
              { "if": { "properties": { "resolve_by": { "const": "assume" } } }, "then": { "required": ["assumption"] } }
            ]
          }
        },
        "questions_to_owner": {
          "type": "array", "maxItems": 5,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "question", "why_it_matters"],
            "properties": {
              "id": { "type": "string", "pattern": "^Q[1-5]$" },
              "question": { "type": "string", "minLength": 10, "maxLength": 300 },
              "why_it_matters": { "type": "string", "minLength": 10, "maxLength": 300 },
              "options": { "type": "array", "maxItems": 4, "items": { "type": "string", "maxLength": 120 } }
            }
          }
        },
        "constraints": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 200 } },
        "sensitive_topics": {
          "type": "array", "maxItems": 6, "uniqueItems": true,
          "items": { "enum": ["war", "politics", "tragedy", "religion", "health", "children", "competitor_named", "price_claim", "none"] }
        },
        "recommended_depth": { "enum": ["light", "standard", "deep"] },
        "recommended_playbooks": {
          "type": "array", "minItems": 1, "maxItems": 3,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["playbook", "why"],
            "properties": {
              "playbook": { "$ref": "#/$defs/PlaybookRef" },
              "why": { "type": "string", "minLength": 10, "maxLength": 300 }
            }
          }
        },
        "data_class": { "$ref": "#/$defs/DataClass" }
      },
      "allOf": [
        { "if": { "properties": { "status": { "const": "needs_owner_input" } } }, "then": { "properties": { "questions_to_owner": { "minItems": 1 } } } },
        { "if": { "properties": { "status": { "const": "ready" } } }, "then": { "properties": { "questions_to_owner": { "maxItems": 0 } } } },
        { "if": { "properties": { "sensitive_topics": { "contains": { "enum": ["war", "politics", "tragedy"] } } } }, "then": { "properties": { "status": { "const": "needs_owner_input" } } } }
      ]
    },

    "WorkPlan": {
      "$comment": "WorkPlan.v1 — CMO step 7-9. Server checks (semantic): playbook exists in registry and is not program@*; brief_fields validate against that playbook's brief schema; depends_on references existing ids; graph is acyclic; owner_gates.after references existing ids.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "diagnosis", "objective", "depth", "workstreams", "owner_gates", "success_criteria", "estimated_owner_minutes", "data_class"],
      "properties": {
        "schema_version": { "const": "WorkPlan.v1" },
        "diagnosis": { "$ref": "#/$defs/ArtifactRef" },
        "objective": { "type": "string", "minLength": 10, "maxLength": 400 },
        "strategy_summary": { "type": "string", "maxLength": 800 },
        "depth": { "enum": ["light", "standard", "deep"] },
        "workstreams": {
          "type": "array", "minItems": 1, "maxItems": 6,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "playbook", "purpose", "brief_fields", "depends_on", "cost_class"],
            "properties": {
              "id": { "type": "string", "pattern": "^ws[1-9]$" },
              "playbook": { "$ref": "#/$defs/PlaybookRef" },
              "purpose": { "type": "string", "minLength": 10, "maxLength": 300 },
              "brief_fields": { "type": "object" },
              "depends_on": { "type": "array", "maxItems": 5, "uniqueItems": true, "items": { "type": "string", "pattern": "^ws[1-9]$" } },
              "cost_class": { "enum": ["subscription", "paid"] },
              "budget_usd": { "type": "number", "minimum": 0, "maximum": 500 }
            },
            "allOf": [
              { "if": { "properties": { "cost_class": { "const": "paid" } } }, "then": { "required": ["budget_usd"] } }
            ]
          }
        },
        "owner_gates": {
          "type": "array", "maxItems": 4,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["after", "question"],
            "properties": {
              "after": { "type": "string", "pattern": "^(plan|ws[1-9])$" },
              "question": { "type": "string", "minLength": 10, "maxLength": 300 },
              "options": { "type": "array", "maxItems": 4, "items": { "type": "string", "maxLength": 120 } }
            }
          }
        },
        "success_criteria": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "type": "string", "minLength": 10, "maxLength": 200 } },
        "risks": { "type": "array", "maxItems": 5, "items": { "type": "string", "maxLength": 200 } },
        "open_questions": { "type": "array", "maxItems": 5, "items": { "type": "string", "maxLength": 200 } },
        "estimated_owner_minutes": { "type": "integer", "minimum": 0, "maximum": 240 },
        "data_class": { "$ref": "#/$defs/DataClass" }
      },
      "allOf": [
        { "if": { "properties": { "depth": { "const": "light" } } }, "then": { "properties": { "workstreams": { "maxItems": 2 } } } },
        { "if": { "properties": { "depth": { "const": "standard" } } }, "then": { "properties": { "workstreams": { "maxItems": 4 } } } }
      ]
    },

    "KnowledgeCandidate": {
      "$comment": "KnowledgeCandidate.v1 — produced by research; stored as office.knowledge_docs status=draft; never reaches worker_context until owner approves.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "candidates"],
      "properties": {
        "schema_version": { "const": "KnowledgeCandidate.v1" },
        "candidates": {
          "type": "array", "maxItems": 12,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["kind", "title", "claim", "confidence", "sources", "why_it_matters", "data_class"],
            "properties": {
              "kind": { "enum": ["fact", "market", "insight", "case", "argument", "result", "rejected_idea", "taste_rule"] },
              "title": { "type": "string", "minLength": 5, "maxLength": 200 },
              "claim": { "type": "string", "minLength": 10, "maxLength": 2000 },
              "confidence": { "enum": ["verified", "reported", "assumption"] },
              "sources": { "type": "array", "maxItems": 6, "items": { "$ref": "#/$defs/WebSource" } },
              "valid_until": { "type": "string", "format": "date" },
              "why_it_matters": { "type": "string", "minLength": 10, "maxLength": 500 },
              "owner_question": { "type": "string", "minLength": 10, "maxLength": 300 },
              "supersedes": { "type": "string", "maxLength": 100 },
              "data_class": { "$ref": "#/$defs/DataClass" }
            },
            "allOf": [
              { "if": { "properties": { "confidence": { "const": "verified" } } }, "then": { "properties": { "sources": { "minItems": 1 } } } },
              { "if": { "properties": { "confidence": { "const": "reported" } } }, "then": { "properties": { "sources": { "minItems": 1 } } } },
              { "if": { "properties": { "confidence": { "const": "assumption" } } }, "then": { "required": ["owner_question"] } },
              { "if": { "properties": { "data_class": { "const": "personal" } } }, "then": false }
            ]
          }
        }
      }
    },

    "FactReport": {
      "$comment": "FactReport.v1 — Fact Gate. Semantic (server): verdict=pass iff blocking_claims empty; every blocking id exists in claims; contradicted => verdict fail; all KnowledgeRef approved and not expired.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "subject", "claims", "blocking_claims", "verdict"],
      "properties": {
        "schema_version": { "const": "FactReport.v1" },
        "subject": { "$ref": "#/$defs/ArtifactRef" },
        "claims": {
          "type": "array", "maxItems": 60,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["claim_id", "text", "location", "claim_type", "status", "evidence"],
            "properties": {
              "claim_id": { "type": "string", "pattern": "^C[0-9]{1,2}$" },
              "text": { "type": "string", "minLength": 2, "maxLength": 300 },
              "location": { "type": "string", "minLength": 1, "maxLength": 200 },
              "claim_type": { "enum": ["fact", "price", "statistic", "comparison", "promise", "opinion", "creative_hyperbole"] },
              "status": { "enum": ["verified", "unverified", "contradicted", "not_a_claim"] },
              "evidence": { "type": "array", "maxItems": 4, "items": { "$ref": "#/$defs/KnowledgeRef" } },
              "condition_for_release": { "type": "string", "maxLength": 300 },
              "note": { "type": "string", "maxLength": 300 }
            },
            "allOf": [
              { "if": { "properties": { "status": { "const": "verified" } } }, "then": { "properties": { "evidence": { "minItems": 1 } } } },
              { "if": { "properties": { "status": { "const": "unverified" } } }, "then": { "required": ["condition_for_release"] } },
              { "if": { "properties": { "claim_type": { "enum": ["opinion", "creative_hyperbole"] } } }, "then": { "properties": { "status": { "enum": ["not_a_claim", "verified"] } } } }
            ]
          }
        },
        "blocking_claims": { "type": "array", "maxItems": 60, "uniqueItems": true, "items": { "type": "string", "pattern": "^C[0-9]{1,2}$" } },
        "verdict": { "enum": ["pass", "conditional", "fail"] }
      },
      "allOf": [
        { "if": { "properties": { "verdict": { "const": "pass" } } }, "then": { "properties": { "blocking_claims": { "maxItems": 0 } } } },
        { "if": { "properties": { "verdict": { "const": "conditional" } } }, "then": { "properties": { "blocking_claims": { "minItems": 1 } } } }
      ]
    },

    "ChallengeTest": {
      "type": "object", "additionalProperties": false,
      "required": ["pass", "note"],
      "properties": {
        "pass": { "type": "boolean" },
        "note": { "type": "string", "minLength": 5, "maxLength": 300 }
      }
    },
    "ChallengeReport": {
      "$comment": "ChallengeReport.v1 — recommends, never blocks. Semantic (server): every concept_id exists in subject; if any verdict=weak then stronger_alternative must be non-null.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "subject", "concepts", "stronger_alternative", "recommendation"],
      "properties": {
        "schema_version": { "const": "ChallengeReport.v1" },
        "subject": { "$ref": "#/$defs/ArtifactRef" },
        "concepts": {
          "type": "array", "minItems": 1, "maxItems": 12,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["concept_id", "tests", "verdict", "one_line_reason", "improve"],
            "properties": {
              "concept_id": { "type": "string", "minLength": 1, "maxLength": 40 },
              "tests": {
                "type": "object", "additionalProperties": false,
                "required": ["swap", "three_second", "banality", "proof", "talkability", "brand_fit"],
                "properties": {
                  "swap": { "$ref": "#/$defs/ChallengeTest" },
                  "three_second": { "$ref": "#/$defs/ChallengeTest" },
                  "banality": { "$ref": "#/$defs/ChallengeTest" },
                  "proof": { "$ref": "#/$defs/ChallengeTest" },
                  "talkability": { "$ref": "#/$defs/ChallengeTest" },
                  "brand_fit": { "$ref": "#/$defs/ChallengeTest" }
                }
              },
              "verdict": { "enum": ["strong", "workable", "weak"] },
              "one_line_reason": { "type": "string", "minLength": 10, "maxLength": 200 },
              "improve": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "string", "minLength": 10, "maxLength": 300 } },
              "needs_fact": { "type": "array", "maxItems": 5, "items": { "type": "string", "maxLength": 200 } }
            }
          }
        },
        "stronger_alternative": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object", "additionalProperties": false,
              "required": ["headline", "idea", "why_stronger"],
              "properties": {
                "headline": { "type": "string", "minLength": 3, "maxLength": 120 },
                "idea": { "type": "string", "minLength": 20, "maxLength": 600 },
                "why_stronger": { "type": "string", "minLength": 20, "maxLength": 400 },
                "needs_fact": { "type": "array", "maxItems": 5, "items": { "type": "string", "maxLength": 200 } }
              }
            }
          ]
        },
        "recommendation": { "enum": ["proceed", "proceed_with_alternative", "rethink"] },
        "blind_ranking": { "type": "array", "maxItems": 12, "items": { "type": "string", "maxLength": 40 } }
      },
      "allOf": [
        { "if": { "properties": { "recommendation": { "enum": ["proceed_with_alternative", "rethink"] } } }, "then": { "properties": { "stronger_alternative": { "type": "object" } } } }
      ]
    },

    "DecisionMemo": {
      "$comment": "DecisionMemo.v1 — CMO step 12: owner decision in 5 minutes. Semantic (server): recommendation.option_id exists in options.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "title", "decision_needed", "context", "options", "recommendation", "owner_actions", "reversible", "data_class"],
      "properties": {
        "schema_version": { "const": "DecisionMemo.v1" },
        "title": { "type": "string", "minLength": 5, "maxLength": 120 },
        "decision_needed": { "type": "string", "minLength": 10, "maxLength": 300 },
        "context": { "type": "string", "minLength": 20, "maxLength": 800 },
        "options": {
          "type": "array", "minItems": 2, "maxItems": 3,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "title", "description", "pros", "cons", "risk", "evidence"],
            "properties": {
              "id": { "type": "string", "pattern": "^O[1-3]$" },
              "title": { "type": "string", "minLength": 3, "maxLength": 100 },
              "description": { "type": "string", "minLength": 10, "maxLength": 500 },
              "pros": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "type": "string", "maxLength": 200 } },
              "cons": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "type": "string", "maxLength": 200 } },
              "cost": { "type": "string", "maxLength": 120 },
              "risk": { "enum": ["low", "medium", "high"] },
              "evidence": { "type": "array", "maxItems": 5, "items": { "$ref": "#/$defs/KnowledgeRef" } },
              "artifacts": { "type": "array", "maxItems": 5, "items": { "$ref": "#/$defs/ArtifactRef" } }
            }
          }
        },
        "recommendation": {
          "type": "object", "additionalProperties": false,
          "required": ["option_id", "rationale"],
          "properties": {
            "option_id": { "type": "string", "pattern": "^O[1-3]$" },
            "rationale": { "type": "string", "minLength": 20, "maxLength": 500 }
          }
        },
        "owner_actions": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "type": "string", "minLength": 5, "maxLength": 200 } },
        "deadline": { "type": "string", "format": "date" },
        "reversible": { "type": "boolean" },
        "data_class": { "$ref": "#/$defs/DataClass" }
      }
    },

    "BrainstormParticipant": {
      "type": "object", "additionalProperties": false,
      "required": ["label", "role"],
      "properties": {
        "label": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,40}$" },
        "role": { "enum": ["proposer", "critic", "fact_checker", "synthesizer"] }
      }
    },
    "BrainstormSession": {
      "$comment": "BrainstormSession.v1 — created by owner or CMO. Server enforces: independent phase TaskEnvelopes contain no other participant turns; max_rounds; distinct executor_id per participant label.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "session_id", "topic", "brief", "participants", "max_rounds", "phases", "status", "data_class"],
      "properties": {
        "schema_version": { "const": "BrainstormSession.v1" },
        "session_id": { "$ref": "#/$defs/Uuid" },
        "topic": { "type": "string", "minLength": 5, "maxLength": 200 },
        "brief": { "type": "string", "minLength": 20, "maxLength": 4000 },
        "context_refs": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/KnowledgeRef" } },
        "participants": { "type": "array", "minItems": 2, "maxItems": 5, "items": { "$ref": "#/$defs/BrainstormParticipant" } },
        "max_rounds": { "type": "integer", "minimum": 1, "maximum": 4 },
        "phases": {
          "type": "array", "minItems": 2, "maxItems": 5, "uniqueItems": true,
          "items": { "enum": ["independent", "rebuttal", "alternatives", "fact_check", "synthesis"] },
          "prefixItems": [ { "const": "independent" } ]
        },
        "status": { "enum": ["open", "independent", "rebuttal", "alternatives", "fact_check", "synthesis", "awaiting_owner", "closed", "aborted"] },
        "owner_notes": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 1000 } },
        "data_class": { "$ref": "#/$defs/DataClass" }
      }
    },
    "BrainstormTurn": {
      "$comment": "BrainstormTurn.v1 — one participant contribution. Semantic (server): responds_to/counterarguments reference turns of previous phases only.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "session_id", "round", "phase", "participant", "position", "confidence"],
      "properties": {
        "schema_version": { "const": "BrainstormTurn.v1" },
        "session_id": { "$ref": "#/$defs/Uuid" },
        "round": { "type": "integer", "minimum": 1, "maximum": 4 },
        "phase": { "enum": ["independent", "rebuttal", "alternatives", "fact_check", "synthesis"] },
        "participant": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,40}$" },
        "position": {
          "type": "object", "additionalProperties": false,
          "required": ["summary", "arguments"],
          "properties": {
            "summary": { "type": "string", "minLength": 10, "maxLength": 600 },
            "arguments": {
              "type": "array", "minItems": 1, "maxItems": 6,
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["id", "text"],
                "properties": {
                  "id": { "type": "string", "pattern": "^A[1-6]$" },
                  "text": { "type": "string", "minLength": 10, "maxLength": 500 },
                  "evidence": { "type": "array", "maxItems": 3, "items": { "$ref": "#/$defs/KnowledgeRef" } }
                }
              }
            }
          }
        },
        "responds_to": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 60 } },
        "counterarguments": {
          "type": "array", "maxItems": 6,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["target_turn", "target_argument", "text"],
            "properties": {
              "target_turn": { "type": "string", "maxLength": 60 },
              "target_argument": { "type": "string", "pattern": "^A[1-6]$" },
              "text": { "type": "string", "minLength": 10, "maxLength": 500 }
            }
          }
        },
        "alternatives": { "type": "array", "maxItems": 3, "items": { "type": "string", "minLength": 10, "maxLength": 500 } },
        "claims_needing_check": { "type": "array", "maxItems": 6, "items": { "type": "string", "maxLength": 200 } },
        "confidence": { "enum": ["low", "medium", "high"] }
      },
      "allOf": [
        { "if": { "properties": { "phase": { "const": "independent" } } }, "then": { "properties": { "responds_to": { "maxItems": 0 }, "counterarguments": { "maxItems": 0 } } } },
        { "if": { "properties": { "phase": { "const": "rebuttal" } } }, "then": { "required": ["counterarguments"], "properties": { "counterarguments": { "minItems": 1 } } } }
      ]
    },
    "BrainstormDecision": {
      "$comment": "BrainstormDecision.v1 — synthesis. Disagreements are preserved, never averaged away.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "session_id", "recommendation", "rationale", "consensus", "dissent", "facts_checked", "open_questions", "owner_decision_needed", "rounds_used"],
      "properties": {
        "schema_version": { "const": "BrainstormDecision.v1" },
        "session_id": { "$ref": "#/$defs/Uuid" },
        "recommendation": { "type": "string", "minLength": 10, "maxLength": 800 },
        "rationale": { "type": "string", "minLength": 20, "maxLength": 1200 },
        "consensus": { "enum": ["full", "majority", "split"] },
        "dissent": {
          "type": "array", "maxItems": 5,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["participant", "position", "why"],
            "properties": {
              "participant": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,40}$" },
              "position": { "type": "string", "minLength": 10, "maxLength": 500 },
              "why": { "type": "string", "minLength": 10, "maxLength": 500 }
            }
          }
        },
        "facts_checked": {
          "type": "array", "maxItems": 10,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["claim", "status"],
            "properties": {
              "claim": { "type": "string", "maxLength": 200 },
              "status": { "enum": ["verified", "unverified", "contradicted"] },
              "evidence": { "type": "array", "maxItems": 3, "items": { "$ref": "#/$defs/KnowledgeRef" } }
            }
          }
        },
        "open_questions": { "type": "array", "maxItems": 5, "items": { "type": "string", "maxLength": 200 } },
        "owner_decision_needed": { "type": "boolean" },
        "rounds_used": { "type": "integer", "minimum": 1, "maximum": 4 }
      },
      "allOf": [
        { "if": { "properties": { "consensus": { "enum": ["majority", "split"] } } }, "then": { "properties": { "dissent": { "minItems": 1 } } } },
        { "if": { "properties": { "consensus": { "const": "split" } } }, "then": { "properties": { "owner_decision_needed": { "const": true } } } }
      ]
    }
  }
}
