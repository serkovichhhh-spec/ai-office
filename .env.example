# --- Database: role office_app (no BYPASSRLS). Supabase pooler, transaction mode (port 6543). ---
# postgres://office_app.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# --- Supabase Auth (public values; used only for sign-in) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Worker ---
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/worker/tick.
CRON_SECRET=

# --- AI provider: "stub" (default) or "anthropic" ---
AI_PROVIDER=stub
ANTHROPIC_API_KEY=
# Optional overrides (defaults: claude-haiku-5-5 / claude-sonnet-5-5 / claude-opus-5-5)
ANTHROPIC_MODEL_FAST=
ANTHROPIC_MODEL_BALANCED=
ANTHROPIC_MODEL_STRONG=

# --- Local UI preview only (ignored unless NODE_ENV=development) ---
LOCAL_DEV_USER_ID=

# New versioned workflows are isolated until owner-approved rollout.
OFFICE_PLAN_V1_WORKSPACES=sandbox

# File rollout and server-only Storage credential. Never NEXT_PUBLIC_ for this key.
OFFICE_FILE_WORKSPACES=sandbox
SUPABASE_SERVICE_ROLE_KEY=

# Optional Workspace Agent wake-up. Requires explicit owner configuration and sandbox tests.
OFFICE_TRIGGER_DISPATCH_ENABLED=false
# Manual UI invocation first; cron only after failure tests T4.
OFFICE_TRIGGER_CRON_ENABLED=false
TRIGGERS_DISABLED=0
OFFICE_TRIGGER_WORKSPACES=sandbox
# Set OFFICE_AGENT_<CHANNEL> only in the server environment; never paste tokens into chat.

# Empty until shadow plans have been reviewed and a workspace pilot is approved.
OFFICE_PROGRAM_WORKSPACES=
